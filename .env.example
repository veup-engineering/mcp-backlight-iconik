# Iconik API Configuration
# Option 1: JWT API token (preferred)
ICONIK_API=your_jwt_token_here

# Option 2: App ID and Auth Token (alternative)
# ICONIK_APP_ID=your_app_id
# ICONIK_AUTH_TOKEN=your_auth_token

# Iconik URL (optional, default: https://app.iconik.io)
ICONIK_URL=https://app.iconik.io

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
